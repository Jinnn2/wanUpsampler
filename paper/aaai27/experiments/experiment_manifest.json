{
  "defaults": {
    "LIGHTX2V_REPO": "/mnt/afs_2/houze/LightX2V",
    "MODEL_ROOT": "/mnt/afs_2/houze/Wan-AI/Wan2.1-T2V-1.3B",
    "VAE_PATH": "${MODEL_ROOT}/Wan2.1_VAE.pth",
    "AAAI_PROMPTS": "${PROJECT_ROOT}/changing_resolution/configs/wan_t2v_stage3_compare_10_prompts.txt",
    "AAAI_RESULTS": "${PROJECT_ROOT}/outputs/aaai27_experiments",
    "WAN50_STAGE2_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_clean_368x640_720x1248_stage2_lmdb/latest.pt",
    "WAN50_STAGE2_CONFIG": "${PROJECT_ROOT}/changing_resolution/configs/train_clean_368x640_to_720x1248_lmdb_stage2.yaml",
    "WAN50_STAGE2_480_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_clean_480p720p_stage2_lmdb/latest.pt",
    "WAN50_LORA40_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_tail_skip_lora_step40_to_step50_temporal/latest.safetensors",
    "WAN50_LORA45_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_tail_skip_lora_step45_to_step50/latest.safetensors",
    "DISTILL_STAGE2_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_distill_clean_368x640_720x1248_stage2_14b_cfgdistill_5k_lmdb/latest.pt",
    "DISTILL_STAGE2_CONFIG": "${PROJECT_ROOT}/changing_resolution_distill/configs/train_clean_368x640_to_720x1248_lmdb_stage2_distill.yaml",
    "DISTILL_LORA3_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_distill_last_step_skip_lora_368x640_14b_cfgdistill_5k_step3/latest.safetensors",
    "DISTILL_LORA_480_CKPT": "${PROJECT_ROOT}/outputs/changing_resolution_distill_last_step_skip_lora_14b_cfgdistill_5k_step3/step_0010000.safetensors",
    "DISTILL_LORA_STRENGTH": "0.75",
    "DISTILL_MODEL_ROOT": "/mnt/afs_2/houze/lightx2v/Wan2.1-T2V-14B-StepDistill-CfgDistill",
    "DISTILL_DIT_CKPT": "${DISTILL_MODEL_ROOT}/distill_model.pt",
    "REALESRGAN_X2_CKPT": "/mnt/afs_2/houze/Real-ESRGAN/weights/RealESRGAN_x2plus.pth",
    "DISTILL4_FINAL_QUALITY_EFFICIENCY": "${AAAI_RESULTS}/quality_efficiency_distill4",
    "DISTILL4_GPU": "0",
    "VBENCH_ROOT": "/mnt/afs_2/houze/VBench",
    "VBENCH_PYTHON": "/opt/conda/envs/vbench/bin/python",
    "LORA_ABLATION_REGISTRY": "${AAAI_RESULTS}/ablations/lora_registry.json",
    "STAGE2_ABLATION_REGISTRY": "${AAAI_RESULTS}/ablations/stage2_registry.json",
    "QUALITY_EFFICIENCY_SPEC": "${AAAI_RESULTS}/efficiency/benchmark_spec.json",
    "WAN_PYTHON": "/opt/conda/bin/python",
    "CR_DISTILL_RAW_VIDEO_DIR_1K": "${PROJECT_ROOT}/data/changing_resolution_distill/raw_wan21_14b_cfgdistill_720p_5k",
    "WAN50_FACTORIAL": "${AAAI_RESULTS}/factorial_wan50",
    "DISTILL_FACTORIAL": "${AAAI_RESULTS}/factorial_distill4",
    "WAN50_STEP40_ENDPOINT_STRENGTH": "${AAAI_RESULTS}/wan50_step40_endpoint_strength",
    "WAN50_STEP40_STRENGTH": "${AAAI_RESULTS}/wan50_step40_strength",
    "WAN50_FINAL_QUALITY_EFFICIENCY": "${AAAI_RESULTS}/quality_efficiency_final",
    "WAN50_LORA40_STRENGTH_FINAL": "0.75",
    "WAN50_LORA45_STRENGTH_FINAL": "0.75"
  },
  "tasks": [
    {
      "id": "wan50_stage2_checkpoint",
      "group": "prereq",
      "kind": "artifact",
      "note": "Reuse the trained 368x640 Stage2 checkpoint or finish its existing training job.",
      "evidence": [{"glob": "${WAN50_STAGE2_CKPT}"}]
    },
    {
      "id": "wan50_stage2_480_checkpoint",
      "group": "prereq",
      "kind": "artifact",
      "note": "Reuse the trained 480x832 Stage2 checkpoint for the 1.5x operator table.",
      "evidence": [{"glob": "${WAN50_STAGE2_480_CKPT}"}]
    },
    {
      "id": "wan50_clean_lmdb",
      "group": "prereq",
      "kind": "artifact",
      "note": "Existing 480p/720p clean LMDB used as the step40 trajectory source.",
      "evidence": [{"glob": "${PROJECT_ROOT}/data/changing_resolution/lmdb_480p720p_1k/**/data.mdb"}]
    },
    {
      "id": "wan50_lora40_lmdb",
      "group": "data",
      "depends_on": ["wan50_clean_lmdb"],
      "commands": [
        "TRAIN_STEP=40 TOTAL_SAMPLES=1000 GPU_IDS=0,1,2,3 RESUME=1 bash changing_resolution/scripts/data/build_tail_skip_lora_lmdb_multigpu.sh"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/data/changing_resolution/lmdb_tail_skip_lora_step40_to_step50/**/data.mdb"}]
    },
    {
      "id": "wan50_lora40_checkpoint",
      "group": "train",
      "depends_on": ["wan50_lora40_lmdb"],
      "commands": [
        "TRAIN_STEP=40 NUM_GPUS=4 CUDA_VISIBLE_DEVICES=0,1,2,3 bash changing_resolution/scripts/train/run_tail_skip_lora_training.sh check",
        "TRAIN_STEP=40 NUM_GPUS=4 CUDA_VISIBLE_DEVICES=0,1,2,3 bash changing_resolution/scripts/train/run_tail_skip_lora_training.sh train"
      ],
      "evidence": [{"glob": "${WAN50_LORA40_CKPT}"}]
    },
    {
      "id": "wan50_lora45_checkpoint",
      "group": "prereq",
      "kind": "artifact",
      "note": "Reuse the frozen step45 LoRA checkpoint.",
      "evidence": [{"glob": "${WAN50_LORA45_CKPT}"}]
    },
    {
      "id": "distill_raw_5k",
      "group": "prereq",
      "kind": "artifact",
      "note": "Existing 5k distilled 720p raw videos are required to rebuild the clean-latent LMDB.",
      "evidence": [{"glob": "${CR_DISTILL_RAW_VIDEO_DIR_1K}/**/*.mp4", "min_count": 5000, "min_bytes": 1024}]
    },
    {
      "id": "distill_stage2_lmdb",
      "group": "data",
      "depends_on": ["distill_raw_5k"],
      "commands": [
        "CUDA_VISIBLE_DEVICES=0 bash changing_resolution_distill/scripts/data/build_clean_368x640_720x1248_distill_lmdb.sh lmdb"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/data/changing_resolution_distill/lmdb_clean_368x640_720x1248_14b_cfgdistill_5k/**/data.mdb"}]
    },
    {
      "id": "distill_stage2_checkpoint",
      "group": "train",
      "depends_on": ["distill_stage2_lmdb"],
      "commands": [
        "bash changing_resolution_distill/scripts/train/run_clean_368x640_720x1248_stage2_distill_4gpu.sh model_check",
        "bash changing_resolution_distill/scripts/train/run_clean_368x640_720x1248_stage2_distill_4gpu.sh train"
      ],
      "evidence": [{"glob": "${DISTILL_STAGE2_CKPT}"}]
    },
    {
      "id": "distill_lora3_lmdb",
      "group": "data",
      "depends_on": ["distill_stage2_lmdb"],
      "commands": [
        "GPU_IDS=0,1,2,3 TOTAL_SAMPLES=5000 bash changing_resolution_distill/scripts/data/build_last_step_skip_lora_368x640_lmdb_4gpu.sh"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/data/changing_resolution_distill/lmdb_last_step_skip_lora_368x640_14b_cfgdistill_5k_step3/**/data.mdb"}]
    },
    {
      "id": "distill_480lora_transfer_sweep",
      "group": "ablation",
      "depends_on": ["distill_stage2_checkpoint"],
      "commands": [
        "LORA_CKPT=${DISTILL_LORA_480_CKPT} STAGE2_CHECKPOINT=${DISTILL_STAGE2_CKPT} STRENGTHS='${DISTILL_LORA_STRENGTH}' LIMIT=10 bash changing_resolution_distill/scripts/eval/run_distill_368x640_480p_lora_transfer_sweep.sh"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/distill_480p_lora_transfer_368p/transfer_sweep_summary.csv", "min_bytes": 64}]
    },
    {
      "id": "distill_lora3_checkpoint",
      "group": "train",
      "depends_on": ["distill_lora3_lmdb"],
      "commands": [
        "CUDA_VISIBLE_DEVICES=0,1,2,3 bash changing_resolution_distill/scripts/train/run_last_step_skip_lora_368x640_distill_4gpu.sh check",
        "CUDA_VISIBLE_DEVICES=0,1,2,3 bash changing_resolution_distill/scripts/train/run_last_step_skip_lora_368x640_distill_4gpu.sh train"
      ],
      "evidence": [{"glob": "${DISTILL_LORA3_CKPT}"}]
    },
    {
      "id": "stage2_operator_480p_metrics",
      "group": "operator",
      "depends_on": ["wan50_stage2_480_checkpoint"],
      "commands": [
        "CR_STAGE2_OPERATOR_COMPARE_CKPT=${WAN50_STAGE2_480_CKPT} TOTAL_SAMPLES=50 SPLIT=val bash changing_resolution/scripts/eval/run_clean_480p720p_stage2_operator_compare_multigpu.sh"
      ],
      "evidence": [{
        "globs": [
          "${PROJECT_ROOT}/outputs/changing_resolution_operator_compare_stage2/metrics_val.jsonl",
          "${PROJECT_ROOT}/outputs/changing_resolution_operator_compare_stage2/part_*/metrics_val_*.jsonl"
        ],
        "min_bytes": 64
      }]
    },
    {
      "id": "stage2_operator_480p",
      "group": "operator",
      "depends_on": ["stage2_operator_480p_metrics"],
      "commands": [
        "python changing_resolution/scripts/eval/summarize_operator_compare_table.py --input outputs/changing_resolution_operator_compare_stage2 --split val"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_operator_compare_stage2/tables/summary_val.json"}]
    },
    {
      "id": "stage2_operator_368p",
      "group": "operator",
      "depends_on": ["wan50_stage2_checkpoint"],
      "commands": [
        "python changing_resolution/scripts/eval/eval_clean_resizer_operator_compare.py --data_dir data/changing_resolution/lmdb_368x640_720x1248_1k --data_format lmdb --checkpoint ${WAN50_STAGE2_CKPT} --train_config ${WAN50_STAGE2_CONFIG} --model_root ${MODEL_ROOT} --vae_path ${VAE_PATH} --wan_repo ${LIGHTX2V_REPO} --out_dir ${AAAI_RESULTS}/operator_368p --split val --limit 50 --metrics psnr ssim lpips",
        "python changing_resolution/scripts/eval/summarize_operator_compare_table.py --input ${AAAI_RESULTS}/operator_368p --split val"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/operator_368p/tables/summary_val.json"}]
    },
    {
      "id": "wan50_endpoint_step45",
      "group": "endpoint",
      "depends_on": ["wan50_lora45_checkpoint"],
      "commands": [
        "TRAIN_STEP=45 LORA_CKPT=${WAN50_LORA45_CKPT} LIMIT=10 SKIP_EXISTING=1 bash changing_resolution/scripts/eval/run_tail_skip_lora_360p_clean_pred_compare.sh run"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_tail_skip_lora_clean_pred_compare_360p_368x640/metrics/original_lora_teacher_summary.csv"}]
    },
    {
      "id": "wan50_handoff_sweep",
      "group": "ablation",
      "depends_on": ["wan50_stage2_checkpoint"],
      "commands": [
        "CHANGE_STEPS='30 35 40 45 50' LIMIT=10 SKIP_EXISTING=1 bash changing_resolution/scripts/eval/run_clean_360p_stage2_three_way_step_sweep.sh run"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_clean_360p_stage2_three_way_step_sweep/compare/*.mp4", "min_count": 50, "min_bytes": 1024}]
    },
    {
      "id": "wan50_factorial",
      "group": "factorial",
      "depends_on": ["wan50_stage2_checkpoint", "wan50_lora40_checkpoint", "wan50_lora45_checkpoint"],
      "commands": [
        "python paper/aaai27/experiments/run_factorial.py run --family wan50 --steps 40 45 --prompts ${AAAI_PROMPTS} --out-root ${WAN50_FACTORIAL} --stage2-checkpoint ${WAN50_STAGE2_CKPT} --stage2-train-config ${WAN50_STAGE2_CONFIG} --lora-checkpoint 40=${WAN50_LORA40_CKPT} --lora-checkpoint 45=${WAN50_LORA45_CKPT} --lora-strength ${WAN50_LORA45_STRENGTH_FINAL} --lora-strength-step 40=${WAN50_LORA40_STRENGTH_FINAL} --reuse-root outputs/changing_resolution_clean_360p_stage2_three_way_step_sweep --reuse-root outputs/changing_resolution_tail_skip_lora_stage2_four_way_360p --limit 10 --seed 9700"
      ],
      "evidence": [{"glob": "${WAN50_FACTORIAL}/videos/*/*.mp4", "min_count": 80, "min_bytes": 1024}]
    },
    {
      "id": "wan50_factorial_reuse_source",
      "group": "reuse",
      "kind": "artifact",
      "note": "Optional legacy LoRA45+Stage2 videos; factorial generation still works when absent.",
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_tail_skip_lora_stage2_four_way_360p/videos/lora45_stage2/*.mp4", "min_count": 10, "min_bytes": 1024}]
    },
    {
      "id": "distill_factorial",
      "group": "factorial",
      "depends_on": ["distill_stage2_checkpoint", "distill_480lora_transfer_sweep"],
      "commands": [
        "python paper/aaai27/experiments/run_factorial.py run --family distill4 --steps 3 --prompts ${AAAI_PROMPTS} --out-root ${DISTILL_FACTORIAL} --stage2-checkpoint ${DISTILL_STAGE2_CKPT} --stage2-train-config ${DISTILL_STAGE2_CONFIG} --lora-checkpoint 3=${DISTILL_LORA_480_CKPT} --reuse-root ${AAAI_RESULTS}/distill_480p_lora_transfer_368p/strength_0p75 --limit 10 --seed 9800 --lora-strength ${DISTILL_LORA_STRENGTH} --stage2-use-ema"
      ],
      "evidence": [{"glob": "${DISTILL_FACTORIAL}/videos/*/*.mp4", "min_count": 40, "min_bytes": 1024}]
    },
    {
      "id": "distill_factorial_reuse_source",
      "group": "reuse",
      "kind": "artifact",
      "note": "Optional legacy Base3/LoRA3+Stage2 videos; factorial generation still works when absent.",
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_distill_stage2_four_way_368x640_720x1248/videos/*3_stage2_hr4/*.mp4", "min_count": 20, "min_bytes": 1024}]
    },
    {
      "id": "legacy_quality_efficiency",
      "group": "efficiency",
      "depends_on": ["wan50_stage2_checkpoint"],
      "commands": [
        "BENCH_CASES=direct_720p,stage3_bridge_720p REPEATS=5 bash changing_resolution/scripts/eval/benchmark_generation_time.sh"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_time_compare/time_summary.csv", "min_bytes": 64}]
    },
    {
      "id": "wan50_lora_strength",
      "group": "ablation",
      "depends_on": ["wan50_lora45_checkpoint"],
      "commands": [
        "TRAIN_STEP=45 STRENGTHS='0.5 0.75 1.0' LORA_CKPT=${WAN50_LORA45_CKPT} LIMIT=10 SKIP_EXISTING=1 bash changing_resolution/scripts/eval/run_tail_skip_lora_360p_strength_sweep.sh run"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_tail_skip_lora_strength_sweep_360p_368x640/metrics/strength_sweep_summary.csv", "min_bytes": 64}]
    },
    {
      "id": "distill_checkpoint_selection",
      "group": "ablation",
      "commands": [
        "LIMIT=10 SKIP_COMPLETED=1 bash changing_resolution_distill/scripts/eval/run_last_step_skip_lora_checkpoint_sweep_480p.sh"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/eval_lora_ckpt_sweep_480p/checkpoint_metric_summary.csv", "min_bytes": 64}]
    },
    {
      "id": "distill_renoise_ablation",
      "group": "ablation",
      "commands": [
        "MODES='random resize_flow' OUT_ROOT=${AAAI_RESULTS}/ablation_distill_renoise bash changing_resolution_distill/scripts/eval/old/01_run_interp_renoise_ab.sh"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/ablation_distill_renoise/videos/*.mp4", "min_count": 2, "min_bytes": 1024}]
    },
    {
      "id": "direct_stage3_compare",
      "group": "baseline",
      "commands": [
        "LIMIT=10 SKIP_EXISTING=1 bash changing_resolution/scripts/eval/run_x0pred_480p720p_stage3_three_model_compare.sh"
      ],
      "evidence": [{"glob": "${PROJECT_ROOT}/outputs/changing_resolution_stage3_three_model_compare/compare/*.mp4", "min_count": 10, "min_bytes": 1024}]
    },
    {
      "id": "lora_architecture_loss_ablation",
      "group": "ablation",
      "kind": "artifact",
      "note": "Requires frozen qkvo/qkvo+FFN, rank 8/16/32, and loss-variant checkpoints evaluated on one held-out manifest.",
      "commands": [
        "python paper/aaai27/experiments/compile_ablation_results.py --kind lora --registry ${LORA_ABLATION_REGISTRY} --output ${AAAI_RESULTS}/ablations/lora_architecture_loss.csv"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/ablations/lora_architecture_loss.csv", "min_bytes": 64}]
    },
    {
      "id": "stage2_architecture_loss_ablation",
      "group": "ablation",
      "kind": "artifact",
      "note": "Requires matched 2D/3D, residual/direct, rational/crop, and loss-variant Stage2 checkpoints.",
      "commands": [
        "python paper/aaai27/experiments/compile_ablation_results.py --kind stage2 --registry ${STAGE2_ABLATION_REGISTRY} --output ${AAAI_RESULTS}/ablations/stage2_architecture_loss.csv"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/ablations/stage2_architecture_loss.csv", "min_bytes": 64}]
    },
    {
      "id": "quality_efficiency_spec",
      "group": "efficiency",
      "depends_on": ["vbench_factorials"],
      "commands": [
        "python paper/aaai27/experiments/prepare_quality_efficiency.py --output ${QUALITY_EFFICIENCY_SPEC} --python ${WAN_PYTHON}"
      ],
      "evidence": [{"glob": "${QUALITY_EFFICIENCY_SPEC}", "min_bytes": 256}]
    },
    {
      "id": "peak_memory_and_loading_overhead",
      "group": "efficiency",
      "kind": "artifact",
      "depends_on": ["quality_efficiency_spec"],
      "note": "Four final cold-start cases: Wan50/Distill4 base+interp versus LoRA+Stage2, with one warm-up and five measured repetitions.",
      "commands": [
        "python paper/aaai27/experiments/benchmark_quality_efficiency.py --spec ${QUALITY_EFFICIENCY_SPEC} --output ${AAAI_RESULTS}/efficiency/quality_efficiency.csv --gpu 0 --warmup 1 --repeats 5"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/efficiency/quality_efficiency.csv", "min_bytes": 64}]
    },
    {
      "id": "generalization_videos",
      "group": "generalization",
      "depends_on": ["wan50_factorial", "distill_factorial"],
      "commands": [
        "python paper/aaai27/experiments/run_factorial.py run --family wan50 --steps 45 --prompts paper/aaai27/experiments/generalization_prompts_20.txt --out-root ${AAAI_RESULTS}/generalization/factorial_wan50 --stage2-checkpoint ${WAN50_STAGE2_CKPT} --stage2-train-config ${WAN50_STAGE2_CONFIG} --lora-checkpoint 45=${WAN50_LORA45_CKPT} --limit 20 --seed 11000 --lora-strength 0.75",
        "python paper/aaai27/experiments/run_factorial.py run --family distill4 --steps 3 --prompts paper/aaai27/experiments/generalization_prompts_20.txt --out-root ${AAAI_RESULTS}/generalization/factorial_distill4 --stage2-checkpoint ${DISTILL_STAGE2_CKPT} --stage2-train-config ${DISTILL_STAGE2_CONFIG} --lora-checkpoint 3=${DISTILL_LORA_480_CKPT} --limit 20 --seed 12000 --lora-strength ${DISTILL_LORA_STRENGTH} --stage2-use-ema",
        "python paper/aaai27/experiments/run_vbench_factorials.py prepare --factorial-root ${AAAI_RESULTS}/generalization/factorial_wan50",
        "python paper/aaai27/experiments/run_vbench_factorials.py prepare --factorial-root ${AAAI_RESULTS}/generalization/factorial_distill4"
      ],
      "evidence": [
        {"glob": "${AAAI_RESULTS}/generalization/factorial_wan50/videos/*/*.mp4", "min_count": 80, "min_bytes": 1024},
        {"glob": "${AAAI_RESULTS}/generalization/factorial_distill4/videos/*/*.mp4", "min_count": 80, "min_bytes": 1024}
      ]
    },
    {
      "id": "generalization_vbench",
      "group": "generalization",
      "kind": "external",
      "depends_on": ["generalization_videos"],
      "commands": [
        "python paper/aaai27/experiments/run_vbench_factorials.py run --factorial-root ${AAAI_RESULTS}/generalization/factorial_wan50 --vbench-root ${VBENCH_ROOT} --python ${VBENCH_PYTHON}",
        "python paper/aaai27/experiments/run_vbench_factorials.py run --factorial-root ${AAAI_RESULTS}/generalization/factorial_distill4 --vbench-root ${VBENCH_ROOT} --python ${VBENCH_PYTHON}"
      ],
      "evidence": [
        {"glob": "${AAAI_RESULTS}/generalization/factorial_wan50/metrics/vbench_v1_custom.json", "min_bytes": 64},
        {"glob": "${AAAI_RESULTS}/generalization/factorial_distill4/metrics/vbench_v1_custom.json", "min_bytes": 64}
      ]
    },
    {
      "id": "generalization_review_package",
      "group": "generalization",
      "depends_on": ["generalization_videos"],
      "commands": [
        "python paper/aaai27/experiments/prepare_blind_review.py --factorial-root ${AAAI_RESULTS}/generalization/factorial_wan50",
        "python paper/aaai27/experiments/prepare_blind_review.py --factorial-root ${AAAI_RESULTS}/generalization/factorial_distill4"
      ],
      "evidence": [
        {"glob": "${AAAI_RESULTS}/generalization/factorial_wan50/review/human_ratings.csv", "min_bytes": 64},
        {"glob": "${AAAI_RESULTS}/generalization/factorial_distill4/review/human_ratings.csv", "min_bytes": 64}
      ]
    },
    {
      "id": "generalization_and_failures",
      "group": "generalization",
      "kind": "manual",
      "depends_on": ["generalization_vbench", "generalization_review_package"],
      "note": "Merge three completed rater ballots in each generalization root, run aggregate_human_review.py, then run collect_generalization.py.",
      "commands": [
        "python paper/aaai27/experiments/aggregate_human_review.py summarize --factorial-root ${AAAI_RESULTS}/generalization/factorial_wan50 --min-raters 3",
        "python paper/aaai27/experiments/aggregate_human_review.py summarize --factorial-root ${AAAI_RESULTS}/generalization/factorial_distill4 --min-raters 3",
        "python paper/aaai27/experiments/collect_generalization.py --factorial-root ${AAAI_RESULTS}/generalization/factorial_wan50 --factorial-root ${AAAI_RESULTS}/generalization/factorial_distill4 --output ${AAAI_RESULTS}/generalization/summary.csv"
      ],
      "evidence": [{"glob": "${AAAI_RESULTS}/generalization/summary.csv", "min_bytes": 64}]
    },
    {
      "id": "vbench_factorial_inputs",
      "group": "metrics",
      "depends_on": ["wan50_factorial", "distill_factorial"],
      "commands": [
        "python paper/aaai27/experiments/run_vbench_factorials.py prepare --factorial-root ${WAN50_FACTORIAL}",
        "python paper/aaai27/experiments/run_vbench_factorials.py prepare --factorial-root ${DISTILL_FACTORIAL}"
      ],
      "evidence": [
        {"glob": "${WAN50_FACTORIAL}/metrics/vbench_inputs/*/prompt_map.json", "min_count": 8, "min_bytes": 64},
        {"glob": "${DISTILL_FACTORIAL}/metrics/vbench_inputs/*/prompt_map.json", "min_count": 4, "min_bytes": 64}
      ]
