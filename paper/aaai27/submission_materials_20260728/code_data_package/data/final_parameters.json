    "loss": {
      "l1_weight": 1.0,
      "mse_weight": 0.1,
      "wan50_step40_temporal_weight": 0.05,
      "wan50_step45_temporal_weight": 0.0,
      "distill4_step3_temporal_weight": 0.0,
      "velocity_mse_weight": 0.0,
      "velocity_l1_weight": 0.0
